{
  "name": "sunless-campaign-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node email/campaigns/_shared/build-all.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test",
    "campaigns:build": "node email/campaigns/_shared/build-all.js",
    "campaigns:check": "node email/campaigns/_shared/build-all.js --check",
    "templates:check": "node scripts/sync-resend-templates.js",
    "templates:publish": "node scripts/sync-resend-templates.js --publish",
    "test-email:build": "node email/campaigns/test-editorial-commerce-email/build.js",
    "test-email:check": "node --env-file=.env.local scripts/sync-resend-templates.js --only test-not-for-send-editorial-commerce-01-preview",
    "test-email:publish": "npm run test-email:build && node --env-file=.env.local scripts/sync-resend-templates.js --publish --only test-not-for-send-editorial-commerce-01-preview"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "resend": "^6.17.2",
    "supabase": "^2.112.0",
    "vite": "latest"
  }
}
