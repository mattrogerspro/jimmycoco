#!/bin/sh
# Validate repository-rendered outreach email contracts before every push.
# This hook is intentionally read-only and never writes to Resend.

ROOT=$(git rev-parse --show-toplevel)

echo "pre-push: validating repository-rendered email contracts…"
if npm --prefix "$ROOT" run templates:check; then
  exit 0
fi

echo "pre-push: email contract validation FAILED — push aborted." >&2
exit 1
