# Supabase (server-side; the publishable key is safe to expose, the secret key is not)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Only needed locally for scripts/bootstrap-article-admin.mjs — never set this in Vercel
# SUPABASE_SECRET_KEY=

# Reseller lifecycle emails. Without these the events are logged and skipped,
# so forms and approvals still work — they just send nothing.
AUTOMATION_API_BASE_URL=https://jimmycoco.email
AUTOMATION_API_KEY=must-match-the-automation-project
RESELLER_NOTICE_EMAIL=matthew@jimmycoco.pro

# Transactional calculator reports send when RESEND_API_KEY is configured.
# Manual invoice delivery from the admin order page remains blocked unless
# EMAIL_LIVE_MODE is explicitly set to true in the deployed environment.
RESEND_API_KEY=re_xxx
# Used by gated invoice delivery. Calculator reports always send from the
# verified partnerships@email.jimmycoco.pro address.
RESEND_FROM=Sunless Partnerships <partnerships@email.jimmycoco.pro>
RESEND_REPLY_TO=partnerships@email.jimmycoco.pro
EMAIL_LIVE_MODE=false
