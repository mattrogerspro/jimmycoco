# Server-only provider credentials. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key
RESEND_API_KEY=replace-with-server-only-resend-api-key
RESEND_WEBHOOK_SECRET=replace-after-webhook-creation

# Independent safety gates. The registry, database and this flag must all be enabled.
EMAIL_LIVE_MODE=false
AUTOMATION_API_KEY=replace-with-a-long-random-secret
# Separate least-privilege credential for the browser-based admin audience importer.
AUDIENCE_IMPORT_API_KEY=replace-with-a-different-long-random-secret
AUDIENCE_IMPORT_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Origin of THIS project (the automation/API deployment), used by pro-site to fire lifecycle events.
AUTOMATION_API_BASE_URL=https://jimmycoco.email
CRON_SECRET=replace-with-a-long-random-secret
EMAIL_WORKER_BATCH_SIZE=25

# Verified sending identity.
RESEND_FROM=Sunless Partnerships <partnerships@email.jimmycoco.pro>
RESEND_REPLY_TO=partnerships@email.jimmycoco.pro
EMAIL_SENDER_NAME=Matt
EMAIL_SENDER_TITLE=Partnerships, Sunless by Jimmy Coco
EMAIL_SUPPORT_EMAIL=partnerships@email.jimmycoco.pro
EMAIL_AUDIT_COPY=matthew@jimmycoco.pro
EMAIL_PREFERENCES_BASE_URL=https://jimmycoco.email/api/preferences/unsubscribe
EMAIL_PREFERENCES_SIGNING_SECRET=replace-with-at-least-32-random-characters
EMAIL_BUSINESS_ADDRESS=

# Approved commercial and journey links/terms.
EMAIL_CALENDAR_LINK=
EMAIL_TRIAL_LINK=
EMAIL_TRADE_LINK=
EMAIL_SHADE_GUIDE_LINK=
EMAIL_ORDER_LINK=
EMAIL_UAE_DELIVERY_STATEMENT=
EMAIL_UAE_PARTNER_TERMS=

# Keep these aligned with the Resend domain settings.
EMAIL_OPEN_TRACKING_ENABLED=true
EMAIL_CLICK_TRACKING_ENABLED=true
