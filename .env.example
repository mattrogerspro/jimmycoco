# Server-only provider credentials. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
# Legacy fallback only; prefer SUPABASE_SECRET_KEY for new deployments.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key


RESEND_WEBHOOK_SECRET=whsec_replace-after-webhook-creation

# Independent safety gates. Both the registry campaign and this flag must be enabled.
EMAIL_LIVE_MODE=false
AUTOMATION_API_KEY=generate-a-long-random-secret
# Origin of THIS project (the automation/API deployment), used by pro-site to fire lifecycle events
AUTOMATION_API_BASE_URL=https://jimmycoco.email
EMAIL_PUBLIC_BASE_URL=https://www.jimmycoco.email
EMAIL_UNSUBSCRIBE_SECRET=generate-a-separate-long-random-secret
CRON_SECRET=generate-a-long-random-secret
EMAIL_WORKER_BATCH_SIZE=25

# Verified sending identity.
RESEND_FROM=Sunless Partnerships <partnerships@email.jimmycoco.pro>
RESEND_REPLY_TO=partnerships@email.jimmycoco.pro
EMAIL_SENDER_NAME=Matt
EMAIL_SENDER_TITLE=Partnerships, Sunless by Jimmy Coco
EMAIL_SUPPORT_EMAIL=partnerships@email.jimmycoco.pro
EMAIL_AUDIT_COPY=matthew@jimmycoco.pro
EMAIL_PREFERENCES_LINK=
EMAIL_BUSINESS_ADDRESS=

# Approved commercial and journey links/terms.
EMAIL_CALENDAR_LINK=
EMAIL_TRIAL_LINK=
EMAIL_TRADE_LINK=
EMAIL_SHADE_GUIDE_LINK=
EMAIL_ORDER_LINK=
EMAIL_UAE_DELIVERY_STATEMENT=
EMAIL_UAE_PARTNER_TERMS=

# Keep these aligned with the Resend domain settings.
EMAIL_OPEN_TRACKING_ENABLED=true
EMAIL_CLICK_TRACKING_ENABLED=true
