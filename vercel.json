{
  "framework": "vite",
  "functions": {
    "api/cron/process-sequences.js": { "maxDuration": 60 },
    "api/webhooks/resend.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron/process-sequences", "schedule": "30 6 * * *" }
  ],
  "rewrites": [
    { "source": "/healthz", "destination": "/api/index" },
    { "source": "/api/cron/:path*", "destination": "/api/cron/:path*" },
    { "source": "/api/webhooks/:path*", "destination": "/api/webhooks/:path*" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!email-assets/|api/).*)", "destination": "/index.html" }
  ]
}