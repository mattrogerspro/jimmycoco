SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Local first-admin bootstrap only. Never expose this key to browser code or VITE_* variables.
SUPABASE_SECRET_KEY=sb_secret_replace_me
ARTICLE_ADMIN_INITIAL_PASSWORD=replace_with_a_unique_password_of_12_or_more_characters

# Optional: triggers a new Vercel build whenever an administrator publishes.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/replace_me
